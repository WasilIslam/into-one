# ── Required ──────────────────────────────────────────────────────────────
# Public URL of your deployment (used for OAuth redirects). Local dev: https://localhost:4100
PUBLIC_URL=https://your-app.vercel.app

# Who can sign in (comma-separated emails)
ALLOWED_EMAILS=you@example.com

# 32-byte hex key that encrypts stored OAuth tokens. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Postgres connection string (Neon, Supabase, RDS…). Leave empty locally to use data/db.json
DATABASE_URL=

# OpenAI key for triage + task chat
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini

# Google OAuth client (Web application). Redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack app (see docs/slack-app-manifest.json). Redirect URL: <PUBLIC_URL>/auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# Email sign-in links via Resend (otherwise only "Sign in with Google" works)
RESEND_API_KEY=
RESEND_FROM=you@yourdomain.com

# Whose inbox this is (used in AI prompts and to spot your name in messages)
OWNER_NAME=Alex
OWNER_ROLE=a busy freelance developer

# Local dev port (HTTPS)
INTO_ONE_PORT=4100
